# ==============================================================================
# NUDY PRODUCTION & DEVELOPMENT CONFIGURATION
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Nudy"

# App Environment (development, staging, production)
NODE_ENV="development"

# Secret Key for JWT & Session signing (Generate with: openssl rand -base64 32)
AUTH_SECRET="your-super-secret-auth-key-change-in-production-min-32-chars"
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL / SQLite for local quick dev)
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL
DATABASE_URL="postgresql://nudy_user:nudy_password@localhost:5432/nudy_db?schema=public"
# For local zero-dependency testing fallback:
# DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# REDIS / QUEUE
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# S3-COMPATIBLE OBJECT STORAGE (AWS S3, Cloudflare R2, MinIO)
# Private by default with pre-signed URL generation
# ------------------------------------------------------------------------------
STORAGE_PROVIDER="mock" # Options: mock | s3 | r2 | minio
S3_ENDPOINT="" # Leave empty for AWS; set for R2 (https://<account-id>.r2.cloudflarestorage.com) or MinIO
S3_REGION="us-east-1"
S3_BUCKET_NAME="nudy-private-assets"
S3_ACCESS_KEY_ID="your-s3-access-key-id"
S3_SECRET_ACCESS_KEY="your-s3-secret-access-key"
S3_FORCE_PATH_STYLE="false" # Set true for local MinIO

# ------------------------------------------------------------------------------
# AI GENERATION PROVIDER ENGINE
# Options: mock | comfyui | generic_rest
# ------------------------------------------------------------------------------
GENERATION_PROVIDER="mock"

# ComfyUI Self-Hosted Endpoint
COMFYUI_HTTP_URL="http://127.0.0.1:8188"
COMFYUI_WS_URL="ws://127.0.0.1:8188/ws"

# Generic REST Provider (e.g. RunPod Serverless / Fal / Custom API)
GENERIC_REST_API_URL="https://api.your-inference-host.com/v1"
GENERIC_REST_API_KEY="your-generic-rest-inference-api-key"

# ------------------------------------------------------------------------------
# KYC & IDENTITY VERIFICATION (Age Gate Compliance)
# Options: mock | persona | veriff | sumsub
# ------------------------------------------------------------------------------
KYC_PROVIDER="mock"
KYC_API_KEY="your-kyc-provider-api-key"
KYC_API_SECRET="your-kyc-provider-api-secret"
KYC_WEBHOOK_SECRET="your-kyc-webhook-secret"

# ------------------------------------------------------------------------------
# PAYMENT & SUBSCRIPTIONS (Adult-friendly processor or Stripe)
# Options: mock | stripe | ccbill | segpay
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER="mock"
PAYMENT_API_KEY="your-payment-secret-key"
PAYMENT_WEBHOOK_SECRET="your-payment-webhook-secret"

# ------------------------------------------------------------------------------
# ADMIN CREDENTIALS & INITIAL SETUP
# ------------------------------------------------------------------------------
ADMIN_EMAIL="admin@nudy.local"
ADMIN_INITIAL_PASSWORD="AdminSecurePassword18+!"

